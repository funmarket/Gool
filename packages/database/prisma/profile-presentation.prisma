model UserProfilePresentation {
  userId          String   @id
  displayName     String?  @db.VarChar(120)
  username        String?  @unique @db.VarChar(64)
  displayUsername String?  @db.VarChar(64)
  photoUrl        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([username])
}
