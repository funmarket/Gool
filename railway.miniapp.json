{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm -w @hooma/contracts run build && npm -w @hooma/miniapp run build"
  },
  "deploy": {
    "startCommand": "npm -w @hooma/miniapp run start",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
